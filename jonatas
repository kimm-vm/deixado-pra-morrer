import pyxel
import math

class Personagem:
    def __init__(self,x,y,largura,altura,cor):
        self.x = x
        self.y = y 
        self.largura = largura
        self.altura = altura
        self.cor = cor

    def draw(self):
        pyxel.rect(self.x, self.y, self.largura, self.altura, self.cor)

class Tiro:
    def __init__(self,x,y, vx, vy, mousex, mousey):
        self.vx, self.vy = 0, 0
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy
        self.mousex = mousex
        self.mousey = mousey

    def update(self):
        self.distancia = math.sqrt(abs(((self.mousex - self.x)**2+(self.mousey-self.y)**2)))
        if self.mousex > self.x:
            self.vx += (abs(self.mousex-self.x)/self.distancia)*4
        elif self.mousex < self.x:
            self.vx -= (abs(self.mousex-self.x)/self.distancia)*4
        else:
            pass

        if self.mousey > self.y:
            self.vy += (abs(self.mousey-self.y)/self.distancia)*4
        elif self.mousey < self.y:
            self.vy -= (abs(self.mousey-self.y)/self.distancia)*4
        else:
            pass

        if (self.x + self.vx) >= 256 or (self.x + self.vx) <= 0 or (self.y + self.vy) <= 0 or (self.y + self.vy) >= 150:
            return 0, 0, False
        return self.vx, self.vy, True

    def draw(self):
        pyxel.circ(self.x+self.vx,self.y+self.vy,1,7)



class Jogo:
    def __init__(self):
        pyxel.init(256, 150, title="Jogo")
        self.personagem = Personagem(123,70,10,10,8)

        self.vx, self.vy = 0, 0

        self.mousey, self.mousex = 0, 0
        self.atirando = False
        self.tiroobj = None
        
        pyxel.run(self.update, self.draw)

    def mover(self):
        if pyxel.btn(pyxel.KEY_W):
            self.personagem.y -= 1
        if pyxel.btn(pyxel.KEY_S):
            self.personagem.y += 1
        if pyxel.btn(pyxel.KEY_A):
            self.personagem.x -= 1
        if pyxel.btn(pyxel.KEY_D):
            self.personagem.x += 1

    def update(self):
        self.visible = True
        self.mover()
        pyxel.mouse(self.visible)
        if pyxel.btnr(pyxel.MOUSE_BUTTON_LEFT):
            self.atirando = True
            self.mousex = pyxel.mouse_x
            self.mousey = pyxel.mouse_y
            self.vx, self.vy = 0, 0

        if self.atirando:
            self.tiroobj = Tiro(self.personagem.x,self.personagem.y,self.vx,self.vy, self.mousex, self.mousey)
            aux, temp, self.atirando = self.tiroobj.update()
            self.vx = aux
            self.vy = temp

    def draw(self):
        pyxel.cls(0)

        self.personagem.draw()

        if self.atirando and self.tiroobj:
            self.tiroobj.draw()

#        pyxel.text(110, 70, 'Jogar\n\nEstatísticas\n\nSair', 7)

Jogo()
