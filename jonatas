import pyxel

class Personagem:
    def __init__(self,x,y,largura,altura,cor):
        self.x = x
        self.y = y 
        self.largura = largura
        self.altura = altura
        self.cor = cor

    def draw(self):
        pyxel.rect(self.x, self.y, self.largura, self.altura, self.cor)

class Jogo:
    def __init__(self):
        pyxel.init(256, 140, title="Jogo")
        self.personagem = Personagem(123,70,10,10,8)
        self.vx, self.vy = 0, 0
        self.mousey, self.mousex = 0, 0
        self.atirar = False
        
        pyxel.run(self.update, self.draw)

    def mover(self):
        if pyxel.btn(pyxel.KEY_W):
            self.personagem.y -= 1
        if pyxel.btn(pyxel.KEY_S):
            self.personagem.y += 1
        if pyxel.btn(pyxel.KEY_A):
            self.personagem.x -= 1
        if pyxel.btn(pyxel.KEY_D):
            self.personagem.x += 1

    def tiro(self,x,y, vx, vy, mousex, mousey):
        distancia = (((mousex - x)**2+(mousey-y)**2))**(1/2)
        if mousex > x and not (x + vx == mousex):
            vx += ((mousex+x)/distancia)
        elif mousex < x and not (x + vx == mousex):
            vx -= (mousex + x)/distancia
        else:
            pass

        if mousey > y and not (y + vy == mousey):
            vy += (mousey+y)/distancia
        elif mousey < y and not (y + vy == mousey):
            vy -= (mousey+y)/distancia
        else:
            pass

        if abs(x + vx) >= mousex and abs(y + vy) >= mousey:
            return 0, 0, False
        return vx, vy, True


    def update(self):
        self.visible = True
        self.mover()
        pyxel.mouse(self.visible)
        if pyxel.btn(pyxel.MOUSE_BUTTON_LEFT):
            self.atirar = True
            self.mousex = pyxel.mouse_x
            self.mousey = pyxel.mouse_y

        if self.atirar:
            aux, temp, self.atirar = self.tiro(self.personagem.x,self.personagem.y,self.vx,self.vy, self.mousex, self.mousey)
            self.vx = aux
            self.vy = temp

    def draw(self):
        pyxel.cls(0)
        if self.atirar:
            pyxel.circ(self.personagem.x+self.vx,self.personagem.y+self.vy,3,8)

#        pyxel.text(110, 70, 'Jogar\n\nEstatísticas\n\nSair', 7)
        self.personagem.draw()
Jogo()
