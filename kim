import pyxel

class Personagem:
    def __init__(self,x,y,largura,altura,cor):
        self.x = x
        self.y = y
        self.largura = largura
        self.altura = altura
        self.cor = cor

    def draw(self):
        pyxel.rect(self.x, self.y, self.largura, self.altura, self.cor)

class Jogo:
    def __init__(self):
        pyxel.init(256, 140, title="Jogo")
        
        
        pyxel.run(self.update, self.draw)

    def update(self):
        self.visible = True
        
        pyxel.mouse(self.visible)
        self.mousex = pyxel.mouse_x
        self.mousey = pyxel.mouse_y
        if pyxel.btn(pyxel.MOUSE_BUTTON_LEFT):
            print(self.mousex)
            print(self.mousey)
        if self.mousex > 105 and self.mousex < 128 and self.mousey > 65 and self.mousey < 78:
            pass
        if self.mousex > 105 and self.mousex < 155 and self.mousey > 78 and self.mousey < 87:
            pass
        if self.mousex > 105 and self.mousex < 125 and self.mousey > 95 and self.mousey < 110:
            pyxel.quit()
            

    def draw(self):
        pyxel.cls(0)
        pyxel.text(110, 70, 'Jogar\n\nEstatísticas\n\nSair', 7)

Jogo()
