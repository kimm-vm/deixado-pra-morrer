    def mover(self,obj,up,down,left,right):
        dx=0
        dy=0
        if pyxel.btn(up):
            dy = -1
        if pyxel.btn(down):
            dy = 1
        if pyxel.btn(left):
            dx = -1
        if pyxel.btn(right):
            dx = 1

        if dx != 0 and (self.bate_na_parede(obj, dx, 0) or self.bate_no_zumbi(obj, dx, 0)):
            dx = 0
        if dy != 0 and (self.bate_na_parede(obj, dx, dy) or self.bate_no_zumbi(obj, dx, dy)):
            dy = 0

        obj.mover(dx,dy)

    def todos_zumbis(self):     #faz os zumbis extras terem colisao comm o personagem e com eles mesmos
        return [self.zumbi] + self.zumbis_extras.get(self.estado, [])

    def bate_no_zumbi(self, obj, dx, dy):
        for z in self.todos_zumbis():
            if z.largura == 0:   #zumbi morto
                continue
            nova = math.hypot(z.x1 - (obj.x1 + dx), z.y1 - (obj.y1 + dy))
            atual = math.hypot(z.x1 - obj.x1, z.y1 - obj.y1)
            if nova < 16 and nova < atual:
                return True
        return False

    def bate_na_parede(self, obj, dx, dy):
        x = obj.x1 + dx + obj.hit_x
        y = obj.y1 + dy + obj.hit_y
        for px, py, pl, pa in PAREDES.get(self.estado, []):
            if x < px + pl and x + obj.hit_l > px and y < py + pa and y + obj.hit_a > py:
                return True
        return False

    def colisao_seg_zumb(self,obj1,obj2):
        self.colisaoX = (obj2.x1 <= obj1.x1 and obj1.x1 <= obj2.x2) or (obj2.x1 <= obj1.x2 and obj1.x2 <= obj2.x2) 
        self.colisaoY = (obj2.y1 <= obj1.y1 and obj1.y1 <= obj2.y2) or (obj2.y1 <= obj1.y2 and obj1.y2 <= obj2.y2)
        if self.colisaoX and self.colisaoY:
            return False
        else:
            return False

    def colisao_zumb_tiro(self,obj1,tiro):
        colisaoX = (obj1.x1 <= tiro.x <= obj1.x2) 
        colisaoY = (obj1.y1 <= tiro.y <= obj1.y2)
        return colisaoX and colisaoY

