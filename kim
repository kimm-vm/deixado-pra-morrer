class Personagem:
    def __init__(self ,x ,y , largura, altura, cor, spritel, spritec, img):
        self.x1=x
        self.y1=y
        self.largura=largura
        self.altura=altura
        self.cor = cor
        self.spritel = spritel #linha
        self.spritec = spritec #coluna
        self.images = img

        #animacao
        self.frame_atual = 0
        self.cont = 0
        self.velocidade = 6
        self.andando = False
        self.olhando_esquerda = False
        self.direcao = "baixo"
        
        self.x2 = self.x1 + self.largura
        self.y2 = self.y1 + self.altura

        self.hit_x = 0
        self.hit_y = 0
        self.hit_l = 17
        self.hit_a = 20
 
    def mover(self,dx,dy):
        self.x1 += dx
        self.y1 += dy
        self.x2 = self.x1 + self.largura
        self.y2 = self.y1 + self.altura

        self.andando = (dx != 0 or dy != 0)
        if dy < 0:
            self.direcao = "cima"
        elif dy > 0:
            self.direcao = "baixo"
        elif dx != 0:
            self.direcao = "lado"


        if dx < 0:
            self.olhando_esquerda = True
        elif dx > 0:
            self.olhando_esquerda = False

        self.animar()

    def animar(self):
        if self.andando == True: 
            self.cont += 1
            if self.cont == self.velocidade:
                self.cont = 0
                self.frame_atual = (self.frame_atual + 1) % self.spritec

        else:
            self.frame_atual = 0 
        
    def draw(self):
        u = self.frame_atual * self.spritel

        if self.direcao == "baixo":
            v = 0
        elif self.direcao == "cima":
            v = self.spritel
        else:
            v = self.spritel * 2

        if (self.direcao == "lado" and self.olhando_esquerda):
            largura = -self.spritel 
        else:
            largura = self.spritel    #faz virar para o lado esquerdo direito!

        pyxel.blt(self.x1, self.y1, self.images, u, v, largura, self.spritel, self.cor)                     

class Zumbi(Personagem):
    def __init__(self, x, y, largura, altura, cor, spritel, spritec, velocidademov, img):
        Personagem.__init__(self, x, y, largura, altura, cor, spritel, spritec,img)   #essa linha serve para herdar tudo da classe personagem, sem ter q escrever tudo dnv
        self.velocidademov = velocidademov

        self.img3 = img
        self.vida = 1

    def seguir(self, alvo, outros=()):
        dx = alvo.x1 - self.x1
        dy = alvo.y1 - self.y1

        distancia = math.hypot(dx, dy)    #hypot calcula a hopotenusa das coordenadas

        if distancia > 18:   
            dx = (dx / distancia) * self.velocidademov
            dy = (dy / distancia) * self.velocidademov
        else:
            dx = 0
            dy = 0

        
        if (dx != 0 or dy != 0) and self.bate_em_outro(self.x1 + dx, self.y1 + dy, outros):
            if not self.bate_em_outro(self.x1 + dx, self.y1, outros):
                dy = 0
            elif not self.bate_em_outro(self.x1, self.y1 + dy, outros):
                dx = 0
            else:
                dx = 0
                dy = 0

        self.mover(dx, dy)

    def bate_em_outro(self, nx, ny, outros):
        for o in outros:
            if o is self or o.largura == 0:   
                continue
            nova = math.hypot(o.x1 - nx, o.y1 - ny)
            atual = math.hypot(o.x1 - self.x1, o.y1 - self.y1)
            if nova < 14 and nova < atual:   #
                return True
        return False

    def draw(self):     #tentativa de fazer os sprites dos zumbis funcionarem!
        u = self.frame_atual * self.spritel

        if self.direcao == "baixo":
            v = 0
        elif self.direcao == "cima":
            v = self.spritel
        else:
            v = self.spritel * 2

        if (self.direcao == "lado" and self.olhando_esquerda):
            largura = -self.spritel 
        else:
            largura = self.spritel    #faz virar para o lado esquerdo direito!

        pyxel.blt(self.x1, self.y1, self.img3, u, v, largura, self.spritel, self.cor)  #e so colocar o valor 1, para usar a outra biblioteca de imagem

class Tiro:
    def __init__(self, x, y, mousex, mousey):
        self.x = x
        self.y = y

        dx = mousex - x
        dy = mousey - y
        distancia = math.hypot(dx, dy)
        
        if distancia > 0:
            self.vx = (dx / distancia) * 4
            self.vy = (dy / distancia) * 4
        else:
            self.vx, self.vy = 0, 0

    def update(self):
        self.x += self.vx
        self.y += self.vy

        if self.x < 0 or self.x > 256 or self.y < 0 or self.y > 150:
            return False
        return True

    def draw(self):
        pyxel.circ(self.x, self.y, 1, 7)

